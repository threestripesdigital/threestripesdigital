{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rank-boost-command-center",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rank-boost-analytics",
      "database_id": "ee4bf499-5656-49eb-a728-13f1eafd2cf1",
      "migrations_dir": "migrations"
    },
    {
      "binding": "LEADS_DB",
      "database_name": "rankboost-leads",
      "database_id": "072ff1b9-a238-424d-9c03-6ae26ecf74a1"
    }
  ],
  "triggers": {
    "crons": [
      "7 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "REPORTING_TIMEZONE": "America/New_York",
    "CURRENCY": "USD",
    "DAILY_BUDGET": "100",
    "FUNNEL_ORIGINS": "https://threestripesdigital.com,https://www.threestripesdigital.com,https://tsd-law-firm-rank-boost.pages.dev",
    "META_ACCOUNT_ID": "358826439854169",
    "META_CAMPAIGN_IDS": "",
    "META_API_VERSION": "v25.0",
    "LAUNCH_AT": "",
    "META_CAMPAIGN_PREFIX": "Rank Boost"
  },
  "account_id": "17f7c095d40a8771cf3568fdcae11770"
}
